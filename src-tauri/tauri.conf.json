{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZoePlane",
  "version": "0.1.0",
  "identifier": "com.brinscorp.zoeplane",
  "build": {
    "frontendDist": "../src/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZoePlane",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/zoeplane-sidecar"],
    "resources": {
      "../sidecar/src/db/migrations": "migrations"
    }
  },
  "plugins": {
    "shell": {
      "open": false
    },
    "deep-link": {
      "desktop": {
        "schemes": ["zoeplane"]
      }
    },
    "fs": {
      "scope": {
        "allow": ["$HOME/.claude/**", "$APPDATA/com.brinscorp.zoeplane/**", "$APP/**"],
        "deny": []
      }
    }
  }
}
