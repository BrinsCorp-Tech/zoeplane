{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the ZoePlane main window. Grants the minimum permission surface required by Sprint 1 IPC commands and plugin usage. Enumerated against src-tauri/gen/schemas/desktop-schema.json per ADR-002.",
  "windows": ["main"],
  "platforms": ["macOS", "linux", "windows"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/.claude/**", "$APPDATA/com.brinscorp.zoeplane/**", "$APP/**"]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "zoeplane-sidecar",
          "sidecar": true,
          "args": [
            "--db-path",
            { "validator": "^.+$" },
            "--migrations-dir",
            { "validator": "^.+$" }
          ]
        },
        {
          "name": "open",
          "cmd": "open",
          "args": [{ "validator": "^-R$" }, { "validator": "^.+$" }]
        },
        {
          "name": "open-default",
          "cmd": "open",
          "args": [{ "validator": "^.+$" }]
        },
        {
          "name": "explorer",
          "cmd": "explorer",
          "args": [{ "validator": "^/select,.+$" }]
        },
        {
          "name": "xdg-open",
          "cmd": "xdg-open",
          "args": [{ "validator": "^.+$" }]
        },
        {
          "name": "code",
          "cmd": "code",
          "args": [{ "validator": "^.+$" }]
        },
        {
          "name": "cursor",
          "cmd": "cursor",
          "args": [{ "validator": "^.+$" }]
        },
        {
          "name": "zed",
          "cmd": "zed",
          "args": [{ "validator": "^.+$" }]
        },
        {
          "name": "cmd-start",
          "cmd": "cmd",
          "args": [
            { "validator": "^/c$" },
            { "validator": "^start$" },
            { "validator": "^$" },
            { "validator": "^.+$" }
          ]
        }
      ]
    },
    "dialog:default",
    "notification:default",
    "process:default",
    "deep-link:default"
  ]
}
