{
  "name": "zoeplane",
  "version": "0.1.0",
  "description": "ZoePlane — OSS cockpit and plugin host for Claude-Code-native teams",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "src",
    "sidecar",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd src dev",
    "build": "bun run --cwd packages/design-tokens build && bun run --cwd src build && bun run --cwd sidecar build",
    "tauri": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'sidecar/src/**/*.ts' 'packages/*/src/**/*.ts'",
    "typecheck": "bun run --cwd src typecheck && bun run --cwd sidecar typecheck && bun run --cwd packages/shared-types typecheck && bun run --cwd packages/plugin-sdk typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:build": "bun run --cwd packages/design-tokens build",
    "tokens:check": "bun run --cwd packages/design-tokens check-tokens"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "internal-ip": "^7.0.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "clsx": "^2.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^2.4.0",
    "zustand": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  }
}
