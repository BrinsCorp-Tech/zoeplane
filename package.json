{
  "name": "zoeplane",
  "version": "0.1.0",
  "description": "ZoePlane — OSS cockpit and plugin host for Claude-Code-native teams",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "src",
    "sidecar",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd src dev",
    "build": "bun run --cwd packages/design-tokens build && bun run --cwd src build && bun run --cwd sidecar build",
    "tauri": "bun run --cwd sidecar build && cargo tauri dev",
    "tauri:build": "bun run --cwd sidecar build && cargo tauri build",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'sidecar/src/**/*.ts' 'packages/*/src/**/*.ts'",
    "typecheck": "bun run --cwd src typecheck && bun run --cwd sidecar typecheck && bun run --cwd packages/shared-types typecheck && bun run --cwd packages/plugin-sdk typecheck",
    "test": "vitest run",
    "test:contrast": "vitest run src/test/contrast-harness.a11y.test.ts",
    "test:watch": "vitest",
    "tokens:build": "bun run --cwd packages/design-tokens build",
    "tokens:check": "bun run --cwd packages/design-tokens check-tokens",
    "storybook": "bun run tokens:build && storybook dev -p 6006 --config-dir .storybook",
    "build-storybook": "storybook build --config-dir .storybook --output-dir storybook-static",
    "prepare": "husky"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "3",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-essentials": "8",
    "@storybook/react": "8",
    "@storybook/react-vite": "8",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@testing-library/react": "16.3.2",
    "@types/culori": "4.0.1",
    "@types/jsdom": "28.0.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "axe-core": "4.11.4",
    "chromatic": "11",
    "culori": "4.0.2",
    "eslint": "^9.0.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.3",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "storybook": "8",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "1.0.7",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.59.2",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@tanstack/react-query": "^5.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.0",
    "lucide-react": "1.14.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^2.4.0",
    "zustand": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
