# ZoePlane — .gitignore

# ---- Dependencies ----
node_modules/
.bun-cache/
.pnpm-store/

# ---- Build outputs ----
src/dist/
sidecar/dist/
packages/*/dist/
target/           # Rust/Cargo build artifacts
src-tauri/target/

# ---- Generated design token CSS (build artifact — run `bun run tokens:build`) ----
# Do NOT hand-edit src/styles/tokens.css — it is generated by Style Dictionary v4
# from packages/design-tokens/src/tokens.seed.json.
src/styles/tokens.css

# ---- Tauri bundle artifacts ----
src-tauri/gen/

# ---- Generated sidecar binaries (produced by copy-sidecar.ts postbuild) ----
# Glob keeps src-tauri/binaries/ directory tracked (for future .gitkeep) but
# excludes the platform-stamped binary blobs that copy-sidecar.ts writes.
src-tauri/binaries/zoeplane-sidecar-*

# ---- Bun build cache files ----
**/.*.bun-build

# ---- OS / Editor ----
.DS_Store
.DS_Store?
._*
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.tsbuildinfo
.cache/

# ---- Environment & secrets ----
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
*.cer

# ---- Local Tauri credentials (never commit signing keys) ----
src-tauri/signing/

# ---- SQLite dev databases ----
*.db
*.db-shm
*.db-wal

# ---- Logs ----
*.log
logs/

# ---- Storybook ----
storybook-static/

# ---- Chromatic ----
.chromatic/
chromatic-diagnostics.json
chromatic.log

# ---- Test coverage ----
coverage/
.nyc_output/

# ---- Lockfile hygiene ----
# bun.lock (text format, bun >= 1.2) is the committed lockfile — do not ignore it.
# Older binary bun.lockb is not produced by current Bun versions.
# Exclude competing lock formats so only bun.lock lands in the repo.
package-lock.json
pnpm-lock.yaml
yarn.lock

# ---- Private strategic docs (not for OSS public repo) ----
# Strategic planning, requirements, design specs, and internal handoffs
# stay local. The OSS repo ships code + LICENSE + README + CONTRIBUTING +
# the public docs/ founding documents (ARCHITECTURE.md, INSTALL.md,
# SECURITY.md, etc.) plus accepted ADRs under docs/architecture/decisions/.
#
# `docs/architecture/` uses a wildcard exclude + exemption pattern because
# git refuses to descend into a fully-excluded directory (an `!` re-include
# cannot rescue files whose parent directory was excluded outright).
docs/architecture/*
!docs/architecture/decisions/
!docs/architecture/decisions/**
docs/design/
docs/discovery/
docs/epics/
docs/features/
docs/handoffs/
docs/stories/

# ---- Local working files (not for OSS public repo) ----
whats-next.md
.claude/
