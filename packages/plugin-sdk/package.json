{
  "name": "@zoeplane/plugin-sdk",
  "version": "0.0.1",
  "description": "ZoePlane Plugin SDK — public extension contract for third-party ZoePlane plugins",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "peerDependencies": {},
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BrinsCorp-Tech/zoeplane"
  },
  "publishConfig": {
    "access": "public"
  }
}
