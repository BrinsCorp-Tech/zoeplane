# ---- Guard: detect hand-edits to generated build artifacts ---- #
# src/styles/tokens.css is generated by Style Dictionary v4.
# Filter ADDITIONS/MODIFICATIONS only — the deletion that removes this file
# from version control (the canonical "make-it-a-build-artifact" pattern)
# must be allowed through, but any later add/edit must be blocked.
if git diff --cached --name-only --diff-filter=AM | grep -q '^src/styles/tokens\.css$'; then
  printf '\033[0;31m\n'
  printf '  ERROR: src/styles/tokens.css is a build artifact — do NOT commit it directly.\n'
  printf '  This file is generated by Style Dictionary v4. To update design tokens:\n'
  printf '    1. Edit packages/design-tokens/src/tokens.seed.json\n'
  printf '    2. Run: bun run tokens:build\n'
  printf '    3. The generated tokens.css is gitignored — only commit the seed JSON changes.\n'
  printf '\033[0m\n'
  exit 1
fi

bunx lint-staged && \
  if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
  fi && \
  if ! command -v cargo > /dev/null 2>&1; then
    echo "husky: cargo not found. Install Rust via rustup: https://rustup.rs"
    exit 1
  fi && \
  (cd src-tauri && cargo fmt --check)
